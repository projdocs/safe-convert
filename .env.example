# =============================================================================
# safe-convert — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in all required values before running.
# Never commit .env to version control.
#
# All SAFE_CONVERT_* variables are read by the API service (cmd/api).
# They are prefixed to avoid collisions when sharing an environment with other
# containers.
# =============================================================================


# -----------------------------------------------------------------------------
# AUTHENTICATION
# Required — the service will not start without this.
# -----------------------------------------------------------------------------

# Bearer token callers must present on every request:
#   Authorization: Bearer <token>
# Minimum 32 characters. Generate with: openssl rand -hex 32
SAFE_CONVERT_ACCESS_TOKEN=


# -----------------------------------------------------------------------------
# HTTP SERVER
# Optional — defaults shown.
# -----------------------------------------------------------------------------

# Port the API listens on inside the container. (1–65535)
# SAFE_CONVERT_PORT=8080

# Host-side port exposed by Docker Compose (mapped to SAFE_CONVERT_PORT).
# This is a Compose variable, not read by the Go service.
# SAFE_CONVERT_HOST_PORT=8080

# Server read deadline in seconds. Defends against slow-loris attacks. (5–300)
# SAFE_CONVERT_READ_TIMEOUT_SECS=15

# Server write deadline in seconds for streaming the PDF response. (5–600)
# Must be strictly greater than SAFE_CONVERT_READ_TIMEOUT_SECS.
# SAFE_CONVERT_WRITE_TIMEOUT_SECS=30

# Graceful shutdown window in seconds on SIGTERM before forced exit. (1–120)
# SAFE_CONVERT_SHUTDOWN_TIMEOUT_SECS=30


# -----------------------------------------------------------------------------
# FILE HANDLING
# Optional — defaults shown.
# -----------------------------------------------------------------------------

# Maximum accepted upload size in megabytes. Requests exceeding this are
# rejected before the file reaches LibreOffice. (1–500)
# SAFE_CONVERT_MAX_FILE_SIZE_MB=5


# -----------------------------------------------------------------------------
# CONVERSION
# Optional — defaults shown.
# -----------------------------------------------------------------------------

# Hard deadline in seconds for a single LibreOffice invocation. The worker
# container is force-removed if it does not exit within this window. (5–300)
# SAFE_CONVERT_CONVERSION_TIMEOUT_SECS=30

# Memory limit in megabytes applied to each ephemeral worker container. (128–4096)
# SAFE_CONVERT_CONTAINER_MEMORY_MB=512

# CPU count allocated to each ephemeral worker container. (1–8)
# SAFE_CONVERT_CONTAINER_CPU_COUNT=1


# -----------------------------------------------------------------------------
# OBSERVABILITY
# Optional — defaults shown.
# -----------------------------------------------------------------------------

# Minimum log level. One of: debug, info, warn, error.
# Never use debug in production — it may log file metadata.
# SAFE_CONVERT_LOG_LEVEL=info

# Log output format. One of: json, text.
# json for production aggregation (Loki, CloudWatch); text for local development.
# SAFE_CONVERT_LOG_FORMAT=json


# -----------------------------------------------------------------------------
# DEBUG
# Optional — default: false.
# -----------------------------------------------------------------------------

# When true, worker containers are preserved after conversion for manual
# inspection instead of being destroyed immediately.
# Never use in production.
# SAFE_CONVERT_DEBUG=false
