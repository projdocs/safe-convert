# =============================================================================
# safe-convert — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in all required values before running.
# Never commit .env to version control.
#
# All variables are prefixed SAFE_CONVERT_ to avoid collisions when this
# service shares an environment with other containers.
# =============================================================================


# -----------------------------------------------------------------------------
# AUTHENTICATION
# Required.
# -----------------------------------------------------------------------------

# Bearer token that the Go API must present on every request via the
# Authorization header: "Authorization: Bearer <token>"
# Generate with: openssl rand -hex 32
SAFE_CONVERT_ACCESS_TOKEN=


# -----------------------------------------------------------------------------
# FILE HANDLING
# -----------------------------------------------------------------------------

# Maximum accepted upload size in megabytes. Requests exceeding this limit
# are rejected with 413 before the file is written to disk.
# Default: 5
SAFE_CONVERT_MAX_FILE_SIZE_MB=5

# Comma-separated allowlist of permitted input file extensions (without dots).
# Any extension not on this list is rejected with 415 before any processing.
# Leave empty to reject all uploads (fail-closed default).
# Example: docx,odt,xlsx,ods,pptx,odp,odg,rtf,txt,html,csv
SAFE_CONVERT_ALLOWED_EXTENSIONS=docx,odt,xlsx,ods,pptx,odp,odg,rtf,txt,html,csv

# Directory where uploaded files are staged before conversion.
# Must be on a tmpfs mount. Cleaned up after every request.
# Default: /tmp/safe-convert/in
SAFE_CONVERT_INPUT_DIR=/tmp/safe-convert/in

# Directory where LibreOffice writes the converted PDF.
# Must be on a tmpfs mount. Cleaned up after every request.
# Default: /tmp/safe-convert/out
SAFE_CONVERT_OUTPUT_DIR=/tmp/safe-convert/out


# -----------------------------------------------------------------------------
# CONVERSION BEHAVIOUR
# -----------------------------------------------------------------------------

# Hard timeout in seconds for a single LibreOffice invocation.
# If LibreOffice does not exit within this window, it is sent SIGKILL.
# A weaponised document can cause LibreOffice to hang indefinitely;
# this timeout is the last line of defence against resource exhaustion.
# Default: 30
SAFE_CONVERT_CONVERSION_TIMEOUT_SECS=30

# Maximum number of LibreOffice conversions that may run concurrently.
# LibreOffice can consume 500 MB+ per process. Setting this above your
# available memory will cause OOM kills under load.
# Default: 1 (conservative; increase only after load testing)
SAFE_CONVERT_MAX_CONCURRENT_CONVERSIONS=1


# -----------------------------------------------------------------------------
# HTTP SERVER
# -----------------------------------------------------------------------------

# Port the HTTP service listens on inside the container.
# The host-side port mapping is defined in docker-compose.yml.
# Default: 8080
SAFE_CONVERT_PORT=8080

# Maximum duration in seconds the server will wait to read an entire
# incoming request, including the uploaded file body.
# Defends against slow-loris and stalled upload attacks.
# Default: 60
SAFE_CONVERT_READ_TIMEOUT_SECS=60

# Maximum duration in seconds the server will wait to write the full
# response (i.e. stream the converted PDF back to the caller).
# Must be greater than SAFE_CONVERT_CONVERSION_TIMEOUT_SECS.
# Default: 90
SAFE_CONVERT_WRITE_TIMEOUT_SECS=90

# Graceful shutdown window in seconds. On SIGTERM the server stops
# accepting new requests and waits this long for in-flight conversions
# to finish before forcefully exiting.
# Default: 30
SAFE_CONVERT_SHUTDOWN_TIMEOUT_SECS=30


# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------

# Minimum log level. One of: debug, info, warn, error
# Never use debug in production — it may log file metadata and request bodies.
# Default: info
SAFE_CONVERT_LOG_LEVEL=info

# Log output format. One of: json, text
# Use json in production for structured log aggregation (Loki, CloudWatch, etc.)
# Use text for local development readability.
# Default: json
SAFE_CONVERT_LOG_FORMAT=json
